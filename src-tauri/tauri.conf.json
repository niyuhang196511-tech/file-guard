{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FileGuard",
  "version": "1.14.0",
  "identifier": "com.fileguard.desktop",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FileGuard · 文件变更追溯",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {"../FileGuard-RecordAdmin.cmd": "FileGuard-RecordAdmin.cmd"},
    "externalBin": [
      "binaries/fileguard-engine"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      },
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}